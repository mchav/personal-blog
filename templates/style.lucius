body {
  margin: 0;
  font-family: Garamond, sans-serif;
  color: #eee;
  width: 100vw;
  background-color: #555;
}

a {
  text-decoration: none;
  color: #eee;
}

.navbar {
  overflow: hidden;
  background-color: #333;
}

.navbar a {
  float: left;
  display: block;
  color: #f2f2f2;
  text-align: center;
  padding: 0.875rem 1rem;
  text-decoration: none;
  font-size: 1.0625rem;
}

.navbar a:hover {
  background-color: #ddd;
  color: black;
}

.navbar a.active {
  background-color: lightgrey;
  color: black;

}

.navbar .icon {
  display: none;
}

@media screen and (max-width: 600px) {
  .navbar a:not(:first-child) {display: none;}
  .navbar a.icon {
    float: right;
    display: block;
  }
}

@media screen and (max-width: 600px) {
  .navbar.responsive {position: relative;}
  .navbar.responsive .icon {
    position: absolute;
    right: 0;
    top: 0;
  }
  .navbar.responsive a {
    float: none;
    display: block;
    text-align: left;
  }
}

.posts-summary-section {
  grid-area: posts;
}

.summary-section {
  display: grid;
  grid-template-areas:
    'posts posts posts';
  gap: 1rem;
  margin: 2rem;
  padding: 1rem;
  text-align: center;
}

.post-date {
  font-size: 0.625rem;
}

h2.posts-summary-section {
  text-align: center;
}

.post-section {
  text-align: left;
  color: black;
  background-color: lightgrey;
  box-shadow: 0.1rem 0.1rem 0.1rem 0.1rem black;
  height: fit-content;
  margin-top: 1rem;
  margin-left: 15vw;
  margin-right: 15vw;
  font-size: 1rem;
  padding-top: 1rem;
  padding-bottom: 5rem;
  padding-left: 1rem;
  padding-right: 1rem;
  border-radius: 1rem;
  overflow: scroll;
}

.post-title {
  width: auto;
  display: block;
  text-align: center;
  background-color: white;
  border-radius: 1rem;
  padding: 1rem;
  font-size: 1rem;
}

.new-post-section {
  margin: 2rem;
}

.post-edit-and-preview {
  display: grid;
  grid-template-columns: 1fr 1fr;
  height: 60vh;
}

.preview-post-section {
  display: block;
  overflow: scroll;
  width: 40vw;
  height: 60vh;
  margin: 2rem;
  padding: 0.5rem 0.75rem;
  box-sizing: border-box;
  border: 0.2rem solid #ccc;
  border-radius: 0.5rem;
  background-color: #f8f8f8;
  font-size: 1.5rem;
  color: black;
}

textarea.new-post-section {
  width: 40vw;
  height: 60vh;
  padding: 0.5rem 0.75rem;
  box-sizing: border-box;
  border: 0.2rem solid #ccc;
  border-radius: 0.5rem;
  background-color: #f8f8f8;
  font-size: 0.9rem;
  resize: none;
}

button {
  background-color: darkslategray;
  border: none;
  margin: 1rem;
  color: white;
  padding: 0.5rem 0.75rem;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 1.25rem;
  margin: 0.25rem 0.5rem;
  cursor: pointer;
}

#newPostTitle {
  width: 60vw;
  font-size: 2rem;
}

label {
  display: inline-block;
  padding: 0.5rem 0.75rem;
  font-size: 1.5rem;
}

#showPreviewLabel {
  display: none;
}

#showPreview {
  display: none;
}

@media screen and (max-width: 700px) {
  .post-edit-and-preview {
    width: 100vw;
  }

  .new-post-section {
    margin: 1rem;
  }

  .preview-post-section {
    display: none;
    width: 80vw;
    height: 70vh;
    margin: 1rem;
    padding: 1rem;
    box-sizing: border-box;
    border: 0.1rem solid #ccc;
    border-radius: 0.25rem;
    background-color: #f8f8f8;
    font-size: 0.9rem;
  }

  .post-section {
    color: black;
    background-color: lightgrey;
    box-shadow: 0.1rem 0.1rem 0.1rem 0.1rem black;
    height: fit-content;
    margin-top: 1rem;
    margin-left: 0.2rem;
    margin-right: 0.2rem;
    font-size: 0.8rem;
    padding-top: 1rem;
    padding-bottom: 5rem;
    padding-left: 1rem;
    padding-right: 1rem;
    border-radius: 1rem;
    overflow: scroll;
  }

  #showPreviewLabel {
    display: inline-block;
  }

  #showPreview {
    background-color: white;
    border: none;
    margin: 1rem;
    color: darkgray;
    padding: 0.5rem 0.75rem;
    display: inline-block;
    font-size: 1.5rem;
    margin: 0.25rem 0.5rem;
  }

  textarea.new-post-section {
    width: 80vw;
    height: 70vh;
    margin: 1rem;
    padding: 1rem;
    box-sizing: border-box;
    border: 0.1rem solid #ccc;
    border-radius: 0.25rem;
    background-color: #f8f8f8;
    font-size: 0.6rem;
    resize: none;
  }

  button {
    background-color: darkslategray;
    border: none;
    margin: 0.5em;
    color: white;
    padding: 0.25rem 0.35rem;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 0.75rem;
    margin: 0.125remp 0.25rem;
    cursor: pointer;
  }

  #newPostTitle {
    max-width: 50vw;
    font-size: 1rem;
  }

  label {
    padding: 0.25rem 0.35rem;
    font-size: 0.75rem;
  }
}
